# PostgreSQL Container (used by docker-compose)
POSTGRES_USER=easypay
POSTGRES_PASSWORD=easypay_password

# Application
NODE_ENV=production
PORT=8080

# Database (NestJS connection)
# Use 'postgres' when running with docker-compose
# Use 'localhost' when running drizzle-kit commands locally
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=easypay
DATABASE_PASSWORD=easypay_password
DATABASE_NAME=easypay

# JWT
# Generate strong random values per environment. These are REQUIRED — startup fails if missing.
#   openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-strong-random-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=replace-with-strong-random-secret
JWT_REFRESH_EXPIRATION=7d

# Transfer
# Flat per-transfer fee in minor units (e.g. 200 = ₹2). Set to 0 to disable.
TRANSFER_FEE_MINOR=200
TOPUP_MAX_PER_TX_MINOR=1000000
TOPUP_MAX_DAILY_MINOR=5000000

# Bridge to glitch B2B federation (see BRIDGE_AUTH.md).
# REQUIRED. Shared HMAC salt — must match the glitch side.
#   openssl rand -base64 48
NUXT_BRIDGE_SHARED_SECRET=replace-with-strong-random-secret-at-least-32-chars
# Base URL of the glitch instance. Required.
GLITCH_BASE_URL=http://localhost:3000

# CORS
CORS_ORIGIN=*
