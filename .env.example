# PostgreSQL Container (used by docker-compose)
POSTGRES_USER=easypay
POSTGRES_PASSWORD=easypay_password

# Application
NODE_ENV=development
PORT=8080

# Database (NestJS connection)
# Use 'postgres' when running with docker-compose
# Use 'localhost' when running drizzle-kit commands locally
DATABASE_URL=postgres://easypay:easypay_password@localhost:5432/easypay

# Better Auth
BETTER_AUTH_SECRET=replace-with-strong-random-secret-min-32-chars
BETTER_AUTH_URL=http://localhost:8080

TRANSFER_FEE_MINOR=200
TOPUP_MAX_PER_TX_MINOR=1000000
TOPUP_MAX_DAILY_MINOR=5000000

BRIDGE_SHARED_SECRET=replace-with-strong-random-secret-at-least-32-chars
GLITCH_BASE_URL=http://localhost:3000

CORS_ORIGIN=*
